rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.get(
        'role',
        request.auth.token.get('admin', false) == true ? 'admin' : 'user'
      );
    }

    function isOwner() {
      return signedIn() && role() == 'owner';
    }

    function isAdmin() {
      return isOwner()
        || (signedIn() && (role() == 'admin' || request.auth.token.get('admin', false) == true));
    }

    function isManager() {
      return isAdmin() || (signedIn() && role() == 'manager');
    }

    function isEditor() {
      return isManager() || (signedIn() && role() == 'editor');
    }

    function isProMember() {
      return signedIn() && request.auth.token.get('membershipPlan', 'free') == 'pro';
    }

    function validRole(roleValue) {
      return roleValue in ['user', 'editor', 'manager', 'admin', 'owner'];
    }

    function validPermissions(roleValue, permissions) {
      return permissions.keys().hasOnly([
          'canReadContent',
          'canEditContent',
          'canManageData',
          'canManageUsers',
          'canManageOwners'
        ])
        && permissions.canReadContent == true
        && permissions.canEditContent == (roleValue in ['editor', 'manager', 'admin', 'owner'])
        && permissions.canManageData == (roleValue in ['manager', 'admin', 'owner'])
        && permissions.canManageUsers == (roleValue in ['admin', 'owner'])
        && permissions.canManageOwners == (roleValue == 'owner');
    }

    function validNewUserProfile(userId) {
      return request.resource.data.keys().hasOnly([
          'createdAt',
          'displayName',
          'email',
          'emailVerified',
          'lastLoginAt',
          'membershipPlan',
          'permissions',
          'role',
          'uid',
          'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.membershipPlan == 'free'
        && request.resource.data.role == 'user'
        && validPermissions('user', request.resource.data.permissions);
    }

    function onlyOwnProfileFieldsChanged(userId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'email',
          'emailVerified',
          'lastLoginAt',
          'uid',
          'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.lastLoginAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validAdminRoleChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'permissions',
          'role',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && validRole(request.resource.data.role)
        && validPermissions(request.resource.data.role, request.resource.data.permissions)
        && (
          isOwner()
          || (resource.data.role != 'owner' && request.resource.data.role != 'owner')
        );
    }

    function validMenuVisibility(menuVisibility) {
      return menuVisibility.keys().hasOnly(['components', 'full-apps', 'libraries', 'tools', 'mcp', 'projects', 'security', 'workspace'])
        && menuVisibility.components is bool
        && menuVisibility['full-apps'] is bool
        && menuVisibility.libraries is bool
        && menuVisibility.tools is bool
        && menuVisibility.mcp is bool
        && menuVisibility.projects is bool
        && menuVisibility.security is bool
        && menuVisibility.workspace is bool;
    }

    function validPageAccess(pageAccess) {
      let accessLevels = ['public', 'signedIn', 'user', 'editor', 'manager', 'admin', 'owner'];
      return pageAccess.keys().hasOnly(['components', 'full-apps', 'libraries', 'tools', 'mcp', 'projects', 'security', 'workspace'])
        && pageAccess.components in accessLevels
        && pageAccess['full-apps'] in accessLevels
        && pageAccess.libraries in accessLevels
        && pageAccess.tools in accessLevels
        && pageAccess.mcp in accessLevels
        && pageAccess.projects in accessLevels
        && pageAccess.security in accessLevels
        && pageAccess.workspace in accessLevels;
    }

    function validSiteSettings() {
      return request.resource.data.keys().hasOnly([
          'maintenanceMode',
          'menuVisibility',
          'pageAccess',
          'signupEnabled',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.maintenanceMode is bool
        && request.resource.data.signupEnabled is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && validMenuVisibility(request.resource.data.menuVisibility)
        && validPageAccess(request.resource.data.pageAccess);
    }

    function validWorkspace(userId) {
      return request.resource.data.keys().hasOnly([
          'fingerprint',
          'itemCount',
          'items',
          'updatedAt',
          'updatedByDeviceId',
          'userId'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.fingerprint is string
        && request.resource.data.itemCount is int
        && request.resource.data.itemCount >= 0
        && request.resource.data.items is map
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByDeviceId is string;
    }

    function validWorkspaceVersion(userId) {
      return request.resource.data.keys().hasOnly([
          'createdAt',
          'fingerprint',
          'itemCount',
          'items',
          'label',
          'source',
          'userId'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.createdAt == request.time
        && request.resource.data.fingerprint is string
        && request.resource.data.itemCount is int
        && request.resource.data.itemCount >= 0
        && request.resource.data.items is map
        && request.resource.data.label is string
        && request.resource.data.source in ['manual', 'restore-backup'];
    }

    function validActivityLog() {
      return request.resource.data.keys().hasOnly([
          'action',
          'actorDisplayName',
          'actorEmail',
          'actorRole',
          'actorUid',
          'createdAt',
          'details',
          'summary',
          'targetId'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == role()
        && request.resource.data.action in [
          'auth.login',
          'auth.logout',
          'auth.password.updated',
          'auth.password.reset-requested',
          'workspace.version.created',
          'workspace.version.restored',
          'project.created',
          'project.updated',
          'project.duplicated',
          'project.archived',
          'project.restored',
          'project.deleted',
          'membership.request.created',
          'membership.request.cancelled',
          'admin.membership.reviewed',
          'admin.role.updated',
          'admin.settings.updated'
        ]
        && request.resource.data.createdAt == request.time
        && request.resource.data.summary is string;
    }

    function validNotification(userId) {
      return request.resource.data.keys().hasOnly([
          'createdAt',
          'link',
          'message',
          'readAt',
          'title',
          'type',
          'userId'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.createdAt == request.time
        && request.resource.data.readAt == null
        && request.resource.data.message is string
        && request.resource.data.title is string
        && request.resource.data.type in ['info', 'success', 'warning', 'role'];
    }

    function validMembershipRequestSubmission(userId) {
      return request.resource.data.keys().hasOnly([
          'displayName',
          'email',
          'requestedAt',
          'requestedPlan',
          'reviewedAt',
          'reviewedBy',
          'status',
          'uid',
          'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email is string
        && (
          request.resource.data.displayName == null
          || request.resource.data.displayName is string
        )
        && request.resource.data.requestedPlan == 'pro'
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null;
    }

    function validMembershipRequestResubmission(userId) {
      return resource.data.status in ['approved', 'rejected', 'cancelled']
        && !isProMember()
        && validMembershipRequestSubmission(userId);
    }

    function validMembershipRequestCancellation(userId) {
      return resource.data.uid == userId
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.updatedAt == request.time;
    }

    function validMembershipRequestReview() {
      return resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reviewedAt',
          'reviewedBy',
          'status',
          'updatedAt'
        ])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function validProjectData(userId) {
      return request.resource.data.keys().hasOnly([
          'accentColor',
          'createdAt',
          'description',
          'isFavorite',
          'linkedStorageKeys',
          'name',
          'status',
          'tags',
          'updatedAt',
          'userId'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 200
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 5
        && request.resource.data.linkedStorageKeys is list
        && request.resource.data.linkedStorageKeys.size() <= 50
        && request.resource.data.accentColor in ['green', 'blue', 'amber', 'rose', 'gray']
        && request.resource.data.isFavorite is bool
        && request.resource.data.status in ['active', 'archived'];
    }

    function validNewProject(userId) {
      return validProjectData(userId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validUpdatedProject(userId) {
      return validProjectData(userId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /siteSettings/{settingsId} {
      allow read: if settingsId == 'general';
      allow create, update: if settingsId == 'general' && isAdmin() && validSiteSettings();
      allow delete: if settingsId == 'general' && isOwner();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isManager());
      allow create: if signedIn()
        && request.auth.uid == userId
        && validNewUserProfile(userId);
      allow update: if signedIn()
        && (
          (request.auth.uid == userId && onlyOwnProfileFieldsChanged(userId))
          || (isAdmin() && validAdminRoleChange())
        );
      allow delete: if isOwner();
    }

    match /userWorkspaces/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && validWorkspace(userId);
      allow delete: if signedIn() && request.auth.uid == userId;

      match /versions/{versionId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && validWorkspaceVersion(userId);
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /userProjects/{userId}/items/{projectId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && validNewProject(userId);
      allow update: if signedIn()
        && request.auth.uid == userId
        && validUpdatedProject(userId);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /activityLogs/{activityId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.actorUid == request.auth.uid);
      allow create: if signedIn() && validActivityLog();
      allow update: if false;
      allow delete: if isOwner();
    }

    match /membershipRequests/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && !isProMember()
        && validMembershipRequestSubmission(userId);
      allow update: if signedIn()
        && (
          (request.auth.uid == userId && validMembershipRequestCancellation(userId))
          || (request.auth.uid == userId && validMembershipRequestResubmission(userId))
          || (isAdmin() && validMembershipRequestReview())
        );
      allow delete: if false;
    }

    match /notifications/{userId}/items/{notificationId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && (request.auth.uid == userId || isAdmin())
        && validNotification(userId);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow delete: if signedIn() && (request.auth.uid == userId || isOwner());
    }

    match /content/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isEditor();
    }
  }
}
